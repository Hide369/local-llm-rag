# このファイルを .env にコピーして使う。.env は .gitignore 済みでコミットされない。
#
# 何も設定しなければ、ingest/backend.py の既定（LLM_BACKEND=ollama）で
# ingest/embedder.py の DEFAULT_OLLAMA_HOST (http://127.0.0.1:11434) につながる
# ＝ローカルPCのOllamaをそのまま使う。
#
# ColabのL4 GPUに接続する場合は、colab/run_ollama_server.ipynb を実行して
# 表示されるngrokのURLとAPIキーをここに設定する。詳しくはREADMEの
# 「ColabのL4 GPUに接続する」を参照。

# OLLAMA_HOST=https://xxxx-xx-xx-xxx-xx.ngrok-free.app
# OLLAMA_API_KEY=
# OLLAMA_VLM_MODEL=qwen2.5vl:7b

# --- GB10サーバーのvLLMに向ける場合 -----------------------------------------
#
# 手順は docs/vllm-gb10.md、モデルの選定は docs/vllm-gb10-models.md にある。
# vLLM は OpenAI 互換API（/v1/...）しか出さないので、OLLAMA_HOST に vLLM の URL を
# 入れても動かない。下の LLM_BACKEND で経路ごと切り替えること。

# LLM_BACKEND=vllm

# 生成の接続先。埋め込みとVLMを別ポートに立てているなら、その2つも設定する
# （設定しなければ VLLM_HOST に落ちる）。
# VLLM_HOST=http://127.0.0.1:8000
# VLLM_EMBED_HOST=http://127.0.0.1:8002
# VLLM_VLM_HOST=http://127.0.0.1:8003

# vLLM を --api-key 付きで起動している場合。Authorization: Bearer で送られる。
# VLLM_API_KEY=

# 埋め込みモデルを差し替える場合。
#
# **次元を変えたら、既存の vector_store.sqlite3 は作り直しになる**
# （`python -m scripts.ingest_source --force`）。差分取り込みでは直らない。
# ingest/retrieval.py の RELEVANCE_THRESHOLD も距離の分布が変わるため、
# `python -m scripts.check_retrieval` で測り直すこと。
#
# 接頭辞は、問い合わせと文書とで別の語を求めるモデル（Nemotron-3-Embed など）
# のために使う。bge-m3 は要らないので既定は空。付け忘れてもエラーにはならず、
# 精度だけが静かに落ちる。
# EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-NVFP4
# EMBED_DIM=2048
# EMBED_QUERY_PREFIX=query:_
# EMBED_PASSAGE_PREFIX=passage:_
#
# ↑ 末尾の _ は「ここに半角スペースが入る」という意味の目印である。実際には
#   `EMBED_QUERY_PREFIX="query: "` のように引用符で囲んで空白を残すこと。
