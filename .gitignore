# Python
__pycache__/
*.py[cod]
.pytest_cache/

# 秘密情報を書くファイル。ルート直下の .env にはColabのL4 GPU接続用の
# OLLAMA_HOST / OLLAMA_API_KEY を、infra/gitlab/.env にはローカルGitLabの
# GITLAB_ROOT_PASSWORD を書く。パターンにスラッシュが無いため全階層に一致する。
.env

# 仮想環境
myvenv/
myvenv313/

# ベクトルストア（source からいつでも再生成できるため追跡しない）
vector_store.sqlite3
vector_store.sqlite3.bak-*

# 旧ベクトルDB。本システムはもう使わないが udemy3.py が使い続ける
chroma_db/

# 取り込み対象の原本（バイナリが大きく、内容も配布対象ではない）
source/

# 取り込み先DB。大きく（273MB）、docs_source/ からいつでも作り直せる
docs_store.sqlite3
docs_store.sqlite3.bak-*

# docs_source/ は追跡する（2026-09-13 に ignore から外した）。移植先が
# `fetch_docs` を走らせずに取り込めるようにするためである。外部通信が要るのは
# `fetch_docs` だけなので、これを追跡するとオフラインの移植先でも
# `ingest_source` だけで済む（触る外部は OLLAMA_HOST のみ）。
#
# 代償が2つある。
#
# 1. 26MB がリポジトリに入る。`fetch_docs` で更新するたびに新しいblobが積まれ、
#    langchain-text-splitters.md だけで1回7MBである。頻繁に取り直すなら効く。
# 2. **生成物である。** 手で置いたファイルは docs_sources.toml に記録が残らず、
#    どの版を入れたのか後から追えない。実測 2026-09-13: 未登録のまま置かれた
#    Go 仕様書の生コピーが `go/doc/` に紛れており、取り込めば go-spec.md と
#    重複した劣化版（pandoc属性が残り1節が最大82,825バイト）が入るところだった。
#    **原本は docs/pg_data/ に置き、docs_sources.toml へ登録すること。**
#    docs_source/ の中身は `fetch_docs` が書いたものだけにする。

# 取り込み対象から外した資料。削除ではなく退避しているだけで、戻せば索引に復帰する
source_archive/

# ツールの作業ディレクトリ
.playwright-mcp/

# サブエージェント駆動開発の作業ディレクトリ（台帳・レビュー資材）
.superpowers/
.worktrees/

# Colab用エージェントが作るマシン固有のスキル参照
.agents/skills/*

# git worktree の置き場。中身はチェックアウトまるごとで、追跡すると
# リポジトリを自分自身の中に入れることになる
.worktrees/

# リポジトリには含めないローカル専用スクリプト
udemy[0-9].py
stream.py

# 生成した設計書の試作置き場。成果物であって入力ではないため追跡しない
test-docs/

# 利用者が登録した雛形。原本はそのマシンのものであり、配布対象ではない
# （source/ と同じ理由）
templates/
